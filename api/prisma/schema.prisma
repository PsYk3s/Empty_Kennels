generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Spca {
  id        String   @id @default(cuid())
  name      String
  city      String
  province  String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  animals   Animal[]
  members   Membership[]
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  createdAt DateTime @default(now())

  memberships  Membership[]
  verifications VerificationEvent[]
}

model Membership {
  id     String @id @default(cuid())
  role   Role
  userId String
  spcaId String

  user User @relation(fields: [userId], references: [id])
  spca Spca @relation(fields: [spcaId], references: [id])

  @@unique([userId, spcaId])
}

model Animal {
  id          String   @id @default(cuid())
  name        String
  species     String
  breed       String?
  description String?
  photoUrl    String?
  spcaId      String
  createdAt   DateTime @default(now())

  spca    Spca @relation(fields: [spcaId], references: [id])
  listing Listing?
}

model Listing {
  id              String        @id @default(cuid())
  animalId        String        @unique
  status          ListingStatus
  confidenceScore Int           @default(0)
  lastVerifiedAt  DateTime?

  animal  Animal              @relation(fields: [animalId], references: [id])
  qr      QrToken?
  events  VerificationEvent[]
}

model QrToken {
  id        String   @id @default(cuid())
  token     String   @unique
  listingId String   @unique
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
}

model VerificationEvent {
  id        String   @id @default(cuid())
  signal    Signal
  weight    Float
  source    VerifySource
  createdAt DateTime @default(now())

  listingId String
  userId    String?
  fingerprint String?

  listing Listing @relation(fields: [listingId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
}

enum Role {
  STAFF
  VOLUNTEER
  OWNER
}

enum ListingStatus {
  DRAFT
  AVAILABLE
  UNAVAILABLE
  ADOPTED
}

enum Signal {
  YES
  NO
}

enum VerifySource {
  QR
  WEB
  APP
}
